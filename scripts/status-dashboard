#!/usr/bin/env python3
"""status-dashboard — the in-harness orchestration UI.

Renders work completed / in progress / todo from `pinto list --json`.
Pinto is the only project-management source of truth. This script never
reads features.json and never parses `.pinto/tasks/*.md`.

Usage:
    scripts/status-dashboard                 # terminal summary
    scripts/status-dashboard --html          # also write docs/status-dashboard.html
    scripts/status-dashboard --html-only     # write the HTML, print nothing
    scripts/status-dashboard --out PATH      # HTML destination
    scripts/status-dashboard --root DIR      # project root (default: repo root)
    scripts/status-dashboard --config PATH   # tracker config (default: dashboard.config.json)

progress.md is an optional narrative tail, not a tracker.

The board command is run as an argv list, never through a shell.
"""

from __future__ import annotations

import argparse
import datetime as _datetime
import html
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path

DONE = "done"
ACTIVE = "active"
TODO = "todo"
BOARD_SOURCE = "pinto list --json"

DEFAULT_CONFIG = {
    "project": "",
    # Status vocabularies. Anything unmatched is todo, so only done and active
    # need listing. Compared case-insensitively with -/_/space normalised.
    "status_map": {
        "done": ["done"],
        "active": ["in-progress", "review"],
    },
    # Board source. `command` is an argv list, run without a shell.
    # `items_path` walks into the payload; "" means the payload is the list.
    # `fields` maps our id/title/status onto the tracker's own key names.
    "board": {
        "command": ["pinto", "list", "--json"],
        "items_path": "",
        "fields": {"id": "id", "title": "title", "status": "status"},
    },
    "progress_file": "progress.md",
}


def normalise(word: str) -> str:
    """Fold -, _ and whitespace so 'in-progress' == 'in_progress' == 'In Progress'."""
    return re.sub(r"[\s_-]+", " ", (word or "").strip().lower())


def load_config(root: Path, path: str | None) -> dict:
    """Merge a project config over the defaults. A broken config is reported, not swallowed."""
    candidate = Path(path) if path else (root / "dashboard.config.json")
    if not candidate.is_absolute():
        candidate = root / candidate
    if not candidate.exists():
        return DEFAULT_CONFIG
    raw = json.loads(candidate.read_text())
    cfg = {**DEFAULT_CONFIG, **raw}
    cfg.pop("features_file", None)
    cfg["status_map"] = {**DEFAULT_CONFIG["status_map"], **raw.get("status_map", {})}
    cfg["board"] = {**DEFAULT_CONFIG["board"], **raw.get("board", {})}
    cfg["board"]["fields"] = {**DEFAULT_CONFIG["board"]["fields"],
                              **raw.get("board", {}).get("fields", {})}
    return cfg


# ---------------------------------------------------------------- calculations

def classify(status: str, status_map: dict | None = None) -> str:
    """Map a tracker's status vocabulary onto done / active / todo."""
    m = status_map or DEFAULT_CONFIG["status_map"]
    s = normalise(status)
    if s in {normalise(w) for w in m.get("done", [])}:
        return DONE
    if s in {normalise(w) for w in m.get("active", [])}:
        return ACTIVE
    return TODO


def dig(node: object, path: str) -> object:
    """Follow a dotted key path. Trackers nest (GitHub Projects puts title under content)."""
    for key in [k for k in (path or "").split(".") if k]:
        if not isinstance(node, dict):
            return None
        node = node.get(key)
    return node


def board_items(raw: object, board_cfg: dict | None = None,
                status_map: dict | None = None) -> list[dict]:
    """Shape a pinto list --json payload into items, per the config's path and field names."""
    cfg = board_cfg or DEFAULT_CONFIG["board"]
    node = dig(raw, cfg.get("items_path") or "") if cfg.get("items_path") else raw
    if not isinstance(node, list):
        raise ValueError("pinto list --json must return a JSON array of tasks")
    f = cfg.get("fields", DEFAULT_CONFIG["board"]["fields"])
    return [
        {
            "id": dig(t, f["id"]) or "?",
            "title": dig(t, f["title"]) or "",
            "state": classify(dig(t, f["status"]) or "", status_map),
            "status": dig(t, f["status"]) or "",
        }
        for t in node if isinstance(t, dict)
    ]


def board_from_pinto(raw: object) -> list[dict]:
    return board_items(raw)


def totals(board: list[dict]) -> dict:
    """Count board items by classified state. Board is the only work source."""
    return {
        DONE: sum(1 for u in board if u["state"] == DONE),
        ACTIVE: sum(1 for u in board if u["state"] == ACTIVE),
        TODO: sum(1 for u in board if u["state"] == TODO),
        "source": BOARD_SOURCE,
    }


def build_model(pinto_raw: object, progress_tail: str,
                project: str, generated: str, config: dict | None = None) -> dict:
    cfg = config or DEFAULT_CONFIG
    sm = cfg.get("status_map")
    board = board_items(pinto_raw, cfg.get("board"), sm)
    return {
        "project": project,
        "generated": generated,
        "board": board,
        "totals": totals(board),
        "progress_tail": progress_tail,
    }


# ------------------------------------------------------------------- rendering

MARK = {DONE: "✔", ACTIVE: "▶", TODO: "○"}


def render_terminal(model: dict) -> str:
    t = model["totals"]
    out = [
        "",
        f"  {model['project']} — orchestration status",
        f"  {model['generated']}",
        "",
        f"  {MARK[DONE]} completed {t[DONE]:>3}"
        f"    {MARK[ACTIVE]} in progress {t[ACTIVE]:>3}"
        f"    {MARK[TODO]} todo {t[TODO]:>3}"
        f"    (from {t['source']})",
    ]

    open_items = [b for b in model["board"] if b["state"] != DONE]
    if open_items:
        out += ["", f"  BOARD ({len(open_items)} open)"]
        for b in open_items:
            out.append(f"    {MARK[b['state']]} {b['id']:<6} {b['title'][:56]}")

    if model["progress_tail"]:
        out += ["", "  LAST RECORDED ACTIVITY",
                *(f"    {line}" for line in model["progress_tail"].splitlines()[-3:])]

    out.append("")
    return "\n".join(out)


def _cards(items: list[dict], state: str) -> str:
    tone = {
        DONE: ("emerald", "fa-check"),
        ACTIVE: ("amber", "fa-play"),
        TODO: ("zinc", "fa-circle"),
    }[state]
    if not items:
        return '<div class="text-sm text-zinc-600 italic px-1 py-3">nothing here</div>'
    return "".join(
        f'<div class="bg-zinc-900 border border-zinc-800 rounded-2xl px-4 py-3">'
        f'<div class="flex items-center gap-2">'
        f'<i class="fa-solid {tone[1]} text-{tone[0]}-400 text-xs"></i>'
        f'<span class="font-mono text-xs text-zinc-500">{html.escape(str(i["id"]))}</span>'
        f'</div>'
        f'<div class="text-sm text-zinc-200 mt-1 leading-snug">{html.escape(i["title"])}</div>'
        f'</div>'
        for i in items
    )


def render_html(model: dict) -> str:
    t = model["totals"]
    units = model["board"]
    by = {s: [u for u in units if u["state"] == s] for s in (DONE, ACTIVE, TODO)}
    total = max(len(units), 1)

    def pct(n): return round(100 * n / total)

    return f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{html.escape(model['project'])} — orchestration status</title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body class="bg-zinc-950 text-zinc-200 antialiased">
<div class="max-w-6xl mx-auto px-6 py-12">

  <div class="flex items-end justify-between flex-wrap gap-4 mb-10">
    <div>
      <div class="text-3xl font-semibold tracking-tighter">{html.escape(model['project'])}</div>
      <div class="text-sm text-zinc-500 mt-1">Orchestration status · generated from {html.escape(t['source'])}</div>
    </div>
    <div class="text-xs text-zinc-600 font-mono">{html.escape(model['generated'])}</div>
  </div>

  <div class="grid grid-cols-3 gap-4 mb-8">
    <div class="bg-zinc-900 border border-zinc-800 rounded-3xl p-5">
      <div class="text-4xl font-semibold text-emerald-400 tabular-nums">{t[DONE]}</div>
      <div class="text-sm text-zinc-400 mt-1">completed</div>
    </div>
    <div class="bg-zinc-900 border border-zinc-800 rounded-3xl p-5">
      <div class="text-4xl font-semibold text-amber-400 tabular-nums">{t[ACTIVE]}</div>
      <div class="text-sm text-zinc-400 mt-1">in progress</div>
    </div>
    <div class="bg-zinc-900 border border-zinc-800 rounded-3xl p-5">
      <div class="text-4xl font-semibold text-zinc-400 tabular-nums">{t[TODO]}</div>
      <div class="text-sm text-zinc-400 mt-1">todo</div>
    </div>
  </div>

  <div class="flex h-2 rounded-full overflow-hidden mb-10 bg-zinc-800">
    <div class="bg-emerald-500" style="width:{pct(len(by[DONE]))}%"></div>
    <div class="bg-amber-500" style="width:{pct(len(by[ACTIVE]))}%"></div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-10">
    <div>
      <div class="text-xs uppercase tracking-widest text-emerald-400/80 mb-3">Completed · {len(by[DONE])}</div>
      <div class="space-y-2">{_cards(by[DONE], DONE)}</div>
    </div>
    <div>
      <div class="text-xs uppercase tracking-widest text-amber-400/80 mb-3">In progress · {len(by[ACTIVE])}</div>
      <div class="space-y-2">{_cards(by[ACTIVE], ACTIVE)}</div>
    </div>
    <div>
      <div class="text-xs uppercase tracking-widest text-zinc-500 mb-3">Todo · {len(by[TODO])}</div>
      <div class="space-y-2">{_cards(by[TODO], TODO)}</div>
    </div>
  </div>

  <div class="bg-zinc-900/60 border border-zinc-800 rounded-3xl p-6">
    <div class="text-xs uppercase tracking-widest text-zinc-500 mb-3">Last recorded activity</div>
    <pre class="text-xs text-zinc-400 whitespace-pre-wrap font-mono leading-relaxed">{html.escape(model['progress_tail'] or '(no progress.md)')}</pre>
  </div>

  <div class="text-xs text-zinc-700 mt-8">
    Regenerate with <span class="font-mono text-zinc-500">just status-html</span>. This file is generated — do not edit by hand.
  </div>

</div>
</body>
</html>
"""


# ----------------------------------------------------------------- actions/io

class BoardError(Exception):
    """The configured board command did not produce a usable payload."""


def read_board(root: Path, board_cfg: dict) -> object:
    """Run the configured board command as argv (never through a shell). Fail loud."""
    cmd = board_cfg.get("command") or []
    if not cmd:
        raise BoardError("dashboard config has no board.command")
    if not shutil.which(cmd[0]):
        raise BoardError(f"{cmd[0]} is not on PATH; install pinto-cli to read the board")
    try:
        done = subprocess.run(cmd, cwd=root, capture_output=True, text=True, timeout=20)
    except OSError as exc:
        raise BoardError(f"could not run {' '.join(cmd)}: {exc}") from exc
    if done.returncode != 0:
        err = (done.stderr or done.stdout or "").strip() or f"exit {done.returncode}"
        raise BoardError(f"{' '.join(cmd)} failed: {err}")
    try:
        return json.loads(done.stdout)
    except json.JSONDecodeError as exc:
        raise BoardError(f"{' '.join(cmd)} did not return JSON: {exc}") from exc


def read_progress_tail(root: Path, filename: str = "progress.md", lines: int = 12) -> str:
    try:
        return "\n".join((root / filename).read_text().splitlines()[-lines:])
    except OSError:
        return ""


def main() -> int:
    ap = argparse.ArgumentParser(add_help=True, description=__doc__)
    ap.add_argument("--html", action="store_true", help="also write the HTML dashboard")
    ap.add_argument("--html-only", action="store_true", help="write HTML, print nothing")
    ap.add_argument("--out", default="docs/status-dashboard.html")
    ap.add_argument("--root", default=str(Path(__file__).resolve().parent.parent))
    ap.add_argument("--config", default=None,
                    help="tracker config (default: dashboard.config.json if present)")
    args = ap.parse_args()

    root = Path(args.root).resolve()
    try:
        cfg = load_config(root, args.config)
    except (OSError, json.JSONDecodeError, TypeError, ValueError) as exc:
        print(f"  dashboard config is invalid: {exc}", file=sys.stderr)
        return 2

    try:
        pinto_raw = read_board(root, cfg.get("board", DEFAULT_CONFIG["board"]))
        model = build_model(
            pinto_raw=pinto_raw,
            progress_tail=read_progress_tail(root, cfg.get("progress_file", "progress.md")),
            project=cfg.get("project") or root.name,
            generated=_datetime.datetime.now().strftime("%Y-%m-%d %H:%M"),
            config=cfg,
        )
    except (BoardError, ValueError) as exc:
        print(f"  {exc}", file=sys.stderr)
        return 2

    if args.html or args.html_only:
        out = Path(args.out)
        if not out.is_absolute():
            out = root / out
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(render_html(model))
        if not args.html_only:
            print(render_terminal(model))
        try:
            shown = out.relative_to(root)
        except ValueError:
            shown = out
        print(f"  → dashboard written to {shown}\n")
    else:
        print(render_terminal(model))
    return 0


if __name__ == "__main__":
    sys.exit(main())
