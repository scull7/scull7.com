{
  "name": "scull7.com",
  "private": true,
  "version": "0.4.0",
  "description": "Nathan Sculli resume site — Elm · Melange ports · glassmorphic galaxy · vim UX",
  "type": "module",
  "scripts": {
    "melange": "opam exec -- dune build @site",
    "melange:watch": "opam exec -- dune build @site --watch",
    "elm:make": "elm make src/elm/Main.elm --output=/dev/null",
    "dev": "npm run melange && concurrently -k -n mel,vite -c magenta,cyan \"npm run melange:watch\" \"vite\"",
    "build": "npm run melange && vite build",
    "inject:resume": "node _build/default/src/melange/crawlable/src/melange/crawlable_cli.cjs",
    "inject:resume:dist": "node _build/default/src/melange/crawlable/src/melange/crawlable_cli.cjs inject dist/index.html public/resume.json",
    "preview": "vite preview",
    "opam:init": "opam switch create . 5.2.0 -y --no-install && opam install . --deps-only -y && npm install",
    "opam:deps": "opam install . --deps-only -y",
    "test:e2e": "node e2e/run.mjs",
    "test:e2e:only": "node e2e/navigation.mjs",
    "test": "npm run elm:make && npm run test:e2e"
  },
  "dependencies": {
    "melange": "7.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "playwright": "^1.49.0",
    "vite": "^6.0.0",
    "vite-plugin-elm": "^3.0.1"
  },
  "keywords": [
    "resume",
    "portfolio",
    "elm",
    "melange",
    "ocaml",
    "vim",
    "jsonresume"
  ],
  "author": "Nathan Sculli <nathan@vegasbuckeye.com>",
  "license": "MIT"
}
