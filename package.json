{
  "name": "scull7.com",
  "private": true,
  "version": "0.2.0",
  "description": "Nathan Sculli resume site — Luna UI (MoonBit) · glassmorphic galaxy · vim UX",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "moon build --target js --release && vite build",
    "preview": "vite preview",
    "moon:build": "moon build --target js --release",
    "moon:check": "moon check --target js",
    "test:unit": "moon test --target js",
    "test:e2e": "node e2e/run.mjs",
    "test:e2e:only": "node e2e/navigation.mjs",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "playwright": "^1.49.0",
    "vite": "^6.0.0",
    "vite-plugin-moonbit": "^0.3.0"
  },
  "keywords": [
    "resume",
    "portfolio",
    "luna",
    "moonbit",
    "vim",
    "jsonresume"
  ],
  "author": "Nathan Sculli <nathan@vegasbuckeye.com>",
  "license": "MIT"
}
